# Пароль сервисной учётной записи AD (только чтение).
AD_SERVICE_PASSWORD=change-me

# SMTP AUTH. Если не заданы, используются from_address и AD_SERVICE_PASSWORD
# (как служебный ящик в equipment-csv-mailer).
# SMTP_USER=noreply@domain.local
# SMTP_PASSWORD=change-me

# Доступ к web-интерфейсу (Basic Auth). Без WEB_PASSWORD авторизация выключена.
WEB_USER=admin
WEB_PASSWORD=change-me
