diff --git a/app/services/ping_service.py b/app/services/ping_service.py
index c4c7022..ad88946 100644
--- a/app/services/ping_service.py
+++ b/app/services/ping_service.py
@@ -712,6 +712,47 @@ def _combined(stdout: str | None, stderr: str | None) -> str:
     return "\n".join(parts)
 
 
+def ping_known_device(device: Device) -> dict[str, object]:
+    """ICMP до известного устройства и запись в device_history.
+
+    Используется быстрым ping с карты/карточки: без script_runs, только инвентарь.
+    """
+    if not device or not (device.ip or "").strip():
+        raise ValueError("У устройства нет IP для ping.")
+
+    result = ping_host(device.ip)
+    now = utcnow()
+    previous = device.last_status
+    status = result.status
+    device.last_status = status
+    if status == DeviceStatus.ONLINE:
+        device.last_response_time_ms = result.response_time_ms
+        device.last_seen = now
+    else:
+        device.last_response_time_ms = None
+
+    db.session.add(
+        DeviceHistory(
+            device_id=device.id,
+            timestamp=now,
+            status=status,
+            response_time_ms=result.response_time_ms
+            if status == DeviceStatus.ONLINE
+            else None,
+        )
+    )
+    db.session.commit()
+
+    return {
+        "device_id": device.id,
+        "status": status,
+        "response_time_ms": result.response_time_ms,
+        "previous_status": previous,
+        "changed": previous != status,
+        "checked_at": now.isoformat(),
+    }
+
+
 def _error_text(exc: subprocess.TimeoutExpired) -> str:
     """Текст таймаута плюс кусок вывода, который ping успел напечатать."""
     stdout = exc.stdout or ""
