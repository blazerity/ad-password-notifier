+      : defaultTypeFilterSet();
     favOnly = params.get("fav") === "1";
 
     filtersRoot.querySelectorAll("[data-filter-group]").forEach((btn) => {
@@ -258,6 +291,75 @@
       favFilterBtn.classList.toggle("active", favOnly);
       favFilterBtn.setAttribute("aria-pressed", favOnly ? "true" : "false");
     }
+
+    const layoutParam = params.get("layout");
+    if (layoutParam && VALID_LAYOUTS.has(layoutParam)) {
+      mapLayout = layoutParam;
+    } else {
+      try {
+        const stored = localStorage.getItem(LAYOUT_KEY);
+        mapLayout = stored && VALID_LAYOUTS.has(stored) ? stored : "cards";
+      } catch (_err) {
+        mapLayout = "cards";
+      }
+    }
+    applyMapLayout(mapLayout, { persist: false });
+
+    const sortParam = params.get("sort");
+    if (sortParam && VALID_SORTS.has(sortParam)) {
+      sortMode = sortParam;
+    } else {
+      try {
+        const stored = localStorage.getItem(SORT_KEY);
+        sortMode = stored && VALID_SORTS.has(stored) ? stored : "hostname";
+      } catch (_err) {
+        sortMode = "hostname";
+      }
+    }
+    syncSortUi();
+  }
+
+  function applyMapLayout(nextLayout, options) {
+    const opts = options || {};
+    const layout = VALID_LAYOUTS.has(nextLayout) ? nextLayout : "cards";
+    mapLayout = layout;
+    MAP_VIEW_CLASSES.forEach((className) => {
+      mapRoot.classList.remove(className);
+    });
+    mapRoot.classList.add(`map-view-${layout}`);
+    viewButtons.forEach((btn) => {
+      const active = btn.dataset.mapView === layout;
+      btn.classList.toggle("active", active);
+      btn.setAttribute("aria-pressed", active ? "true" : "false");
+    });
+    if (opts.persist !== false) {
+      try {
+        localStorage.setItem(LAYOUT_KEY, layout);
+      } catch (_err) {
+        /* ignore */
+      }
+    }
+  }
+
+  function syncSortUi() {
+    if (sortSelect) {
+      sortSelect.value = sortMode;
+    }
+  }
+
+  function setSortMode(nextMode, options) {
+    const opts = options || {};
+    sortMode = VALID_SORTS.has(nextMode) ? nextMode : "hostname";
+    syncSortUi();
+    sortAllSectorCards();
+    if (opts.persist !== false) {
+      try {
+        localStorage.setItem(SORT_KEY, sortMode);
+      } catch (_err) {
+        /* ignore */
+      }
+      syncUrlFromFilters();
+    }
   }
 
   function searchIsActive() {
@@ -394,14 +496,45 @@
     return `${name.replace(/\d+/g, (digits) => digits.padStart(10, "0"))}\t${ipKey}`;
   }
 
+  function ipSortKey(ip) {
+    const raw = String(ip || "").trim();
+    const parts = raw.split(".");
+    if (parts.length === 4 && parts.every((part) => /^\d{1,3}$/.test(part))) {
+      return parts
+        .map((part) => String(Number(part)).padStart(3, "0"))
+        .join(".");
+    }
+    return raw.toLowerCase();
+  }
+
+  function macSortKey(mac) {
+    const compact = String(mac || "")
+      .toLowerCase()
+      .replace(/[^0-9a-f]/g, "");
+    if (!compact) {
+      return `\uffff${String(mac || "").toLowerCase()}`;
+    }
+    return compact;
+  }
+
+  function cardSortKey(card) {
+    if (sortMode === "ip") {
+      return `${ipSortKey(card.dataset.ip)}\t${hostnameSortKey(card.dataset.hostname, card.dataset.ip)}`;
+    }
+    if (sortMode === "mac") {
+      return `${macSortKey(card.dataset.mac)}\t${hostnameSortKey(card.dataset.hostname, card.dataset.ip)}`;
+    }
+    return hostnameSortKey(card.dataset.hostname, card.dataset.ip);
+  }
+
   function sortSectorCards(row) {
     if (!row) {
       return;
     }
     const cards = Array.from(row.querySelectorAll("[data-device-card]"));
     cards.sort((left, right) => {
-      const a = hostnameSortKey(left.dataset.hostname, left.dataset.ip);
-      const b = hostnameSortKey(right.dataset.hostname, right.dataset.ip);
+      const a = cardSortKey(left);
+      const b = cardSortKey(right);
       if (a < b) return -1;
       if (a > b) return 1;
       return 0;
@@ -409,6 +542,12 @@
     cards.forEach((card) => row.appendChild(card));
   }
 
+  function sortAllSectorCards() {
+    mapRoot.querySelectorAll("[data-sector-devices]").forEach((row) => {
+      sortSectorCards(row);
+    });
+  }
+
   function renderSectorKindCounts(panel, cards) {
     const host = panel.querySelector("[data-sector-kinds]");
     if (!host) {
@@ -571,10 +710,11 @@
 
