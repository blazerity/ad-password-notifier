+      }
+      applyMapLayout(next);
+      syncUrlFromFilters();
+    });
+  });
+
+  if (sortSelect) {
+    sortSelect.addEventListener("change", () => {
+      setSortMode(sortSelect.value || "hostname");
+    });
+  }
+
   function setStatusClasses(el, status) {
