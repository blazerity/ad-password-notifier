[Unit]
Description=AD Password Notifier (web UI + scheduler)
Documentation=file:///opt/ad-password-notifier/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ad-pwd-notifier
Group=ad-pwd-notifier
WorkingDirectory=/opt/ad-password-notifier
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ad-password-notifier/.venv/bin/python main.py --serve
Restart=on-failure
RestartSec=5
# Логи также в journald; файлы приложения — в logs/
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ad-password-notifier

# Ограничения (без жёсткого sandbox — нужны LDAP/SMTP)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
